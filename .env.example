# mock = full end-to-end local demo without touching DevPanel
# real = call DevPanel REST API
DP_MODE=mock

# Transport: stdio (default) or http (per-user Bearer token via HTTP)
# In http mode, each request must include Authorization: Bearer <token>.
# The token is used as both the auth credential and the plan owner identifier.
DP_TRANSPORT=stdio

# HTTP transport binding (when DP_TRANSPORT=http)
DP_HTTP_HOST=127.0.0.1
DP_HTTP_PORT=3100

# TLS for HTTP transport. Required for production. Cert and key paths are local files.
# Without TLS, tokens are sent in cleartext — only use on localhost or behind a reverse proxy.
DP_HTTP_TLS_ENABLED=false
DP_HTTP_CERT_PATH=
DP_HTTP_KEY_PATH=

DP_API_BASE_URL=https://YOUR-DEVPANEL-API
# Personal access token for DP_MODE=real (also injectable per-request in http transport)
DP_ACCESS_TOKEN=
DP_DEFAULT_WORKSPACE_ID=

# Real CREATE is intentionally gated until a UI request/response is captured.
# Set this only after config/create-profiles/drupal11-demo.json is verified.
DP_ENABLE_REAL_CREATE=false
DP_CREATE_PROFILE=drupal11-demo

# Approval mode: auto = capability negotiation (form > url > external)
# form = force Form Elicitation (native client dialog)
# url = force URL Elicitation (client opens URL)
# external = force external HTTP review page
APPROVAL_MODE=auto

# Human approval UI (external URL fallback)
APPROVAL_HOST=127.0.0.1
APPROVAL_PORT=8787
APPROVAL_PUBLIC_BASE_URL=http://127.0.0.1:8787

# Plan controls
PLAN_TTL_SECONDS=900
