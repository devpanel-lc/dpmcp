{
  "id": "drupal11-demo",
  "verified": true,
  "notes": "Verified 2026-07-31 against a real DevPanel UI create of devpanel-lc/drupal-11 (SampleApp). Request and response captured from the DevPanel UI; response returned top-level _id as the project id.",
  "endpoint": "/api/v2/workspaces/{workspaceId}/projects",
  "method": "POST",
  "payload": {
    "name": "{{projectName}}",
    "projectType": "{{projectType}}",
    "repositoryProvider": "{{repositoryProvider}}",
    "repositoryType": "{{repositoryType}}",
    "repositoryOwner": "{{repositoryOwner}}",
    "repositoryName": "{{repositoryName}}",
    "repositoryId": "{{repositoryId}}",
    "isUsePersonalToken": true,
    "isPrivateRepository": false,
    "instances": [
      {
        "branchType": "{{branchType}}",
        "name": "{{branch}}",
        "originBranch": "{{branch}}"
      }
    ]
  }
}
