{
  "id": "drupal11-demo",
  "verified": false,
  "notes": "Replace this file with a payload captured from a successful DevPanel UI Create Application request before enabling real create.",
  "endpoint": "/api/v2/workspaces/{workspaceId}/projects",
  "method": "POST",
  "payload": {
    "name": "{{projectName}}",
    "repositoryId": "{{repositoryId}}",
    "repositoryOwner": "{{repositoryOwner}}",
    "repositoryName": "{{repositoryName}}",
    "projectType": "{{projectType}}",
    "repositoryType": "{{repositoryType}}",
    "instances": [
      {
        "name": "{{branch}}",
        "originBranch": "{{branch}}",
        "isFromGit": true,
        "appRoot": "/var/www/html",
        "webRoot": "/var/www/html"
      }
    ],
    "repositoryProvider": "{{repositoryProvider}}",
    "isUsePersonalToken": false,
    "isUseRepositoryToken": false,
    "repositoryToken": ""
  }
}
